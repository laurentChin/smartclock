[Unit]
Description=WakeUpClock — Radio réveil connecté
# time-sync.target : attend que l'heure soit synchronisée (le Pi n'a pas d'horloge interne, il démarre sur l'heure
# de sa dernière sauvegarde) pour que les alarmes ne partent pas sur une heure fausse.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# root : le pilotage du panneau RGB (GPIO/DMA) l'exige
User=root
WorkingDirectory=/home/smartclock/smartclock
# -u : sortie non bufferisée, pour retrouver les messages en direct dans journalctl
ExecStart=/home/smartclock/venv/bin/python -u app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
